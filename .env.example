# PostgreSQL
POSTGRES_USER=support_bot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=support_bot
# Для запуска вне docker (uv run ...). В compose api получает адрес db сам.
DATABASE_URL=postgresql+asyncpg://support_bot:change_me@localhost:5432/support_bot

# Redis
REDIS_URL=redis://localhost:6379/0

# Порты на хосте (поменяйте, если стандартные заняты; тогда поправьте и URL выше)
DB_PORT=5432
REDIS_PORT=6379
API_PORT=8000

LOG_LEVEL=INFO

# Эмбеддинги (fastembed). Размерность модели должна совпадать с EMBEDDING_DIM в db/models.py.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_CACHE_DIR=.cache/fastembed
# Размер чанка и перекрытие — в символах
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Claude (Anthropic API)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — для чата достаточно low
LLM_EFFORT=low
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=60

# RAG: сколько чанков брать и минимальная косинусная близость; ниже порога — handoff оператору
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35
# Сколько последних сообщений диалога (вопросы + ответы) передавать модели
HISTORY_MESSAGES=6

# Rate limit на /api/chat, запросов в минуту
RATE_LIMIT_IP_PER_MINUTE=20
RATE_LIMIT_SESSION_PER_MINUTE=10
