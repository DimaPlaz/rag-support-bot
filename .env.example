# PostgreSQL
POSTGRES_USER=support_bot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=support_bot
# Для запуска вне docker (uv run ...). В compose api получает адрес db сам.
DATABASE_URL=postgresql+asyncpg://support_bot:change_me@localhost:5432/support_bot

# Redis
REDIS_URL=redis://localhost:6379/0

# Порты на хосте (поменяйте, если стандартные заняты; тогда поправьте и URL выше)
DB_PORT=5432
REDIS_PORT=6379
API_PORT=8000

LOG_LEVEL=INFO
